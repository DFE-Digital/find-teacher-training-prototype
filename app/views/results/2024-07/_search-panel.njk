<div class="app-promoted-link">

<form action="{{ actions.search.find }}" method="post" accept-charset="utf-8" novalidate>
  <input type="hidden" name="q" value="provider">

  {{ govukInput({
    id: "provider",
    name: "keywords",
    label: {
      text: "Keywords",
      classes: "govuk-label--s"
    }
  }) }}

  {{ govukInput({
  label: {
    text: "City, town or postcode (in England)",
    classes: "govuk-label--s"
  },
    id: "event-name",
    name: "eventName"
  }) }}

<div class="govuk-form-group">
  <label class="govuk-label" for="sort">
    <strong>
      Search radius
    </strong>
  </label>
  <select class="govuk-select" id="sort" name="sort">
    <option value="updated">1 mile</option>
    <option value="views">5 miles</option>
    <option value="comments" selected>10 miles</option>
        <option value="views">15 miles</option>
    <option value="comments">20 miles</option>
        <option value="views">25 miles</option>
    <option value="comments">50 miles</option>
        <option value="views">100 miles</option>
    <option value="comments">200 miles</option>
  </select>
</div>

<button type="submit" class="govuk-button" data-module="govuk-button" style="margin-bottom:5px;">
  Search
</button>

</form>

</div>
